# 必填：PostgreSQL 連線字串。Neon 後台複製 connection string 後，將 postgresql:// 改為 postgresql+asyncpg://
# 例：postgresql+asyncpg://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# OpenWeather API (取得任務區域風速、風向)
# https://openweathermap.org/api
OPENWEATHER_API_KEY=

# OpenAI API (LangChain 任務診斷與結案報告)
OPENAI_API_KEY=

# Google Maps Elevation API (後端環境診斷用，需在 Cloud Console 啟用 Elevation API)
GOOGLE_MAPS_API_KEY=

# CORS 允許來源（逗號分隔），例：http://localhost:5173,https://app.example.com。留空則用 *（不帶 credentials）
# CORS_ORIGINS=http://localhost:5173

# 資料庫連線是否使用 SSL（Neon 等雲端用 true；本地 Postgres 可設 false）
# DB_USE_SSL=true

# 模擬起點 (緯度,經度)，例如台北
SIM_LAT=25.0330
SIM_LNG=121.5654
